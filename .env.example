# ---------- Public ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (leave blank to use the local JSON store in development) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_ and never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Local mode only (no Supabase) ----------
# Session signing secret, 32+ random characters (required in production local mode).
AUTH_SECRET=
# Bootstrap owner account created on first login attempt if no such user exists.
LOCAL_ADMIN_EMAIL=owner@zyvilo.local
LOCAL_ADMIN_PASSWORD=
# Where the local JSON database lives (default ./.data)
# LOCAL_DATA_DIR=

# ---------- Notifications ----------
RESEND_API_KEY=
EMAIL_FROM="Zyvilo <notifications@your-domain.com>"
# Fallback recipients if none are configured in Admin → Settings (comma-separated)
NOTIFY_EMAIL=
# Protects /api/cron/notifications (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# ---------- Bot protection (optional, Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Analytics (optional; shows consent banner when true) ----------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
